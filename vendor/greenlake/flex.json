          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "error_unprocessable_request": {
                    "value": {
                      "debugId": "abbeeb59-12cb-49a3-9ce5-55edba12213f",
                      "errorCode": "HPE_GL_UNPROCESSABLE_CONTENT",
